{
    "names": {
        "microxrcedds_client": {
            "cmake-args": [
                "-DUCLIENT_UDP_TRANSPORT_MTU=2048",
                "-DUCLIENT_MAX_OUTPUT_BEST_EFFORT_STREAMS=1",
                "-DUCLIENT_MAX_OUTPUT_RELIABLE_STREAMS=1"
            ]
        },
        "rmw_microxrcedds": {
            "cmake-args": [
                "-DRMW_UXRCE_XML_BUFFER_LENGTH=400",
                "-DRMW_UXRCE_TRANSPORT=udp",
                "-DRMW_UXRCE_MAX_NODES=1",
                "-DRMW_UXRCE_MAX_PUBLISHERS=12",
                "-DRMW_UXRCE_MAX_SUBSCRIPTIONS=4",
                "-DRMW_UXRCE_MAX_SERVICES=1",
                "-DRMW_UXRCE_MAX_CLIENTS=1",
                "-DRMW_UXRCE_MAX_HISTORY=4",
                "-DRMW_UXRCE_STREAM_HISTORY=8"
            ]
        }
    }
}
